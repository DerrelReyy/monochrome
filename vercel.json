{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://monochrome.st/api/:match*"
    },
    {
      "source": "/stream/:match*",
      "destination": "https://monochrome.st/stream/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
